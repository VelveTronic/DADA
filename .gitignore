# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# subagent scratch
.superpowers/

# Bridge build output: `pnpm bridge:build` writes bridge/dist/dada-bridge.js, a
# 3 MB single-file bundle rebuilt from src/bridge on demand. Only the README that
# tells an operator what the folder is for, and the two secret-free config
# templates (sandbox and production) the operator copies to the ERP server, are
# tracked. `bridge.env` itself — the filled-in file with the two real secrets —
# never is.
/bridge/*
!/bridge/README.md
!/bridge/bridge.env.sandbox
!/bridge/bridge.env.production

# Wingest price export: the full six-tier price matrix for every article, which
# 0002c revokes from authenticated readers. It lands next to the export script
# when the owner runs it; it must never be committed. Delete it after merging.
scripts/wingest/prices.csv

# Ad-hoc diagnostic scripts. They routinely hold a real login while a bug is
# being chased, and one was left in the tree on 2026-08-22 carrying a live
# customer password. Name a throwaway `*.tmp.*` and git will not see it.
*.tmp.mjs
*.tmp.ts
*.tmp.js
