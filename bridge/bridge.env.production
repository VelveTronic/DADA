# =====================================================================
# bridge.env —— 生产模板 / Plantilla de PRODUCCIÓN (wgdemo)
# ---------------------------------------------------------------------
# 用法：把本文件复制到 SERVER 的 C:\dada\bridge\，**改名成 bridge.env**
#       （程序只按这个文件名找配置），再填下面两处 <...> 的密钥。
# Uso:  copiar a C:\dada\bridge\ en SERVER, RENOMBRARLO a `bridge.env`
#       y rellenar los dos secretos marcados con <...>.
#
# ⚠️ 本模板在代码库里，所以**永远不要把真实密钥写回这个文件**。真实值只存在于
#    服务器上那份 bridge.env——不进 git、不进聊天、不进截图。
#
# 部署七步：docs/bridge-manual-simple.md；技术细节：docs/bridge-runbook.md。
# =====================================================================

# ---- Supabase（门户侧）----
SUPABASE_URL=https://gudiykhngonoqsjoigza.supabase.co
# service_role 密钥：从保险库取，粘到 = 后面。一行写完，不加引号，不要换行。
SUPABASE_SERVICE_ROLE_KEY=<在服务器上填：门户的 service_role 密钥>

# ---- Wingest（ERP 侧，生产库）----
# 逗号端口写法，不要用带反斜杠的实例名（驱动会丢掉端口去问 SQL Browser）。
WINGEST_SERVER=SERVER,50352
# 生产库。程序连上后会核对 DB_NAME()，连错库直接拒绝干活。
WINGEST_DB=wgdemo
WINGEST_USER=dada_bridge
WINGEST_PASSWORD=<在服务器上填：dada_bridge 的 SQL 密码>

# ---- 业务参数 / Parámetros ----
# 盖在每张自动 Pedido 上的 ERP 操作员（客户和业务都看得到）。必须存在于
# susuario.CODUSU，最长 4 位。沙盒全链路验证用的是 SFY；换别的代号前先在
# Wingest 里确认它存在——不存在的话注入会在提交前自检失败、整单回滚。
BRIDGE_ERP_USER=SFY

# 年度保险丝：orders 只允许 BRIDGE_EJE 等于 Europe/Madrid 当前年份的后两位。
# 每年 1 月 1 日前把 BRIDGE_EJE 改成新年度（见下），这两行保持 false / 留空。
# 历史补录的受控流程见 runbook 第 ⑧ 节。
BRIDGE_ALLOW_HISTORICAL_EJE=false
BRIDGE_HISTORICAL_ORDER_ID=

# 其余参数的**默认值在生产就是对的，故意不写**：
#   BRIDGE_CAN=B            门户对应的销售公司（canal）
#   BRIDGE_EJE=26           2026 会计年度——跨年时在这里显式写新值
#   BRIDGE_ALM=00001        取 FIFO 批次和写行用的仓库
#   BRIDGE_SERFAC=1         单据序列
#   BRIDGE_LOT_ALLOW_EXPIRED=false / BRIDGE_LOT_EXPIRED_MAX_DAYS=0
#                           只用未过期批次。过期批次照查照数（lotBlocked），
#                           但不写入单据。要放开见 runbook 第 ③ 节，两项必须
#                           同时写，天数上限 180。
#   CLAIM_LIMIT=20          一轮最多认领 20 张订单
#   LEASE_SECONDS=300       认领租约 5 分钟（沙盒模板的 60 秒别带上生产）
